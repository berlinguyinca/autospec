#!/usr/bin/env bash
# tests/fixtures/gh-mock/gh — PATH-shadow stub for `gh` used by autospec-run
# claim/run-state unit tests. Backed by env-pointed JSON files:
#   AUTOSPEC_TEST_LABELS    newline label list (issue view / edit)
#   AUTOSPEC_TEST_COMMENTS  JSON array of {id,body} comments
#   AUTOSPEC_TEST_CALLS     append-only log of every invocation
# Optional knobs:
#   AUTOSPEC_TEST_FORCE_OWNER  rewrite worker_id on every create/patch (race sim)
#   AUTOSPEC_TEST_NEXT_ID      id assigned to the next created comment (default 200)
set -eu

labels="${AUTOSPEC_TEST_LABELS:-/dev/null}"
comments="${AUTOSPEC_TEST_COMMENTS:?}"
calls="${AUTOSPEC_TEST_CALLS:?}"
printf '%s\n' "$*" >> "$calls"

labels_json() {
    jq -Rn '
      [inputs | select(length > 0) | {name:.}] as $labels |
      {
        labels:$labels,
        body:"## Safety review\n<!-- autospec-safety:begin -->\n- **decision:** `SAFETY_PASS`\n<!-- autospec-safety:end -->\n",
        title:"Autospec test issue",
        author:{login:"autospec-test"}
      }
    ' < "$labels"
}

force_owner() {
    if [ -n "${AUTOSPEC_TEST_FORCE_OWNER:-}" ]; then
        sed "s/\"worker_id\":[[:space:]]*\"[^\"]*\"/\"worker_id\":\"${AUTOSPEC_TEST_FORCE_OWNER}\"/"
    else
        cat
    fi
}

if [ "$1" = "repo" ] && [ "$2" = "view" ]; then
    printf 'testorg/testrepo\n'; exit 0
fi
if [ "$1" = "label" ] && [ "$2" = "create" ]; then
    exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "view" ]; then
    jq_expr=""
    shift 2
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --jq) jq_expr="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    if [ -n "$jq_expr" ]; then
        labels_json | jq -r "$jq_expr"
    else
        labels_json
    fi
    exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "edit" ]; then
    shift 2; add=""; remove=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --add-label) add="$2"; shift 2 ;;
            --remove-label) remove="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    [ -z "$remove" ] || { grep -Fxv "$remove" "$labels" > "$labels.tmp" && mv "$labels.tmp" "$labels"; }
    if [ -n "$add" ]; then
        grep -Fx "$add" "$labels" >/dev/null 2>&1 || printf '%s\n' "$add" >> "$labels"
    fi
    exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "comment" ]; then
    body=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --body-file) body="$(cat "$2")"; shift 2 ;;
            --body) body="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    body="$(printf '%s\n' "$body" | force_owner)"
    jq --argjson id "${AUTOSPEC_TEST_NEXT_ID:-200}" --arg body "$body" \
        '. + [{id: $id, body: $body, updated_at:"2026-07-14T00:00:00Z"}]' "$comments" > "$comments.tmp"
    mv "$comments.tmp" "$comments"; exit 0
fi
if [ "$1" = "api" ]; then
    method=""; body=""; url="$2"; shift 2
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -X) method="$2"; shift 2 ;;
            -F) case "$2" in body=@*) body="$(cat "${2#body=@}")" ;; esac; shift 2 ;;
            -f) case "$2" in body=*) body="${2#body=}" ;; esac; shift 2 ;;
            *) shift ;;
        esac
    done
    id="${url##*/}"
    if [ "$url" = "repos/testorg/testrepo/issues/42/comments" ]; then
        cat "$comments"; exit 0
    fi
    case "$method" in
        PATCH)
            body="$(printf '%s\n' "$body" | force_owner)"
            jq --argjson id "$id" --arg body "$body" \
                'map(if .id == $id then .body = $body | .updated_at = "2026-07-14T00:00:00Z" else . end)' "$comments" > "$comments.tmp"
            mv "$comments.tmp" "$comments" ;;
        DELETE)
            jq --argjson id "$id" 'map(select(.id != $id))' "$comments" > "$comments.tmp"
            mv "$comments.tmp" "$comments" ;;
    esac
    exit 0
fi
exit 1
