{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospec.dev/schemas/website-quality/v1.json",
  "title": "Autospec website quality capture",
  "type": "object",
  "required": ["schema_version", "site_id", "run_id", "git_sha", "captured_at", "rubric_version", "config_hash", "pages"],
  "properties": {
    "schema_version": {"const": "website-quality/v1"},
    "site_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "captured_at": {"type": "string"}, "rubric_version": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {"page": {"type": "object", "required": ["route_template", "category_scores", "confidence", "coverage", "validity", "evidence", "defects", "remediation", "acceptance_test"], "properties": {
    "route_template": {"type": "string", "minLength": 1}, "category_scores": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "validity": {"enum": ["current", "stale", "incomplete", "unverifiable"]}, "evidence": {"type": "array", "items": {"type": "string", "pattern": "^[^/]"}},
    "defects": {"type": "array"}, "remediation": {"type": "array"}, "acceptance_test": {"type": "string"}
  }}}
}
