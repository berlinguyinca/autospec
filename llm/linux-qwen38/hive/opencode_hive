#!/usr/bin/env bash
# Bring up a Qwen node on hive and point OpenCode at it, in one command.
#
#   opencode_hive                 acquire a GPU, serve, tunnel, configure, launch
#   opencode_hive status          where things stand
#   opencode_hive stop            drop the tunnel and cancel the job
#   opencode_hive logs            follow the server log
#
# Job scripts and presets are copied from this checkout on every run, so the
# cluster always runs the reviewed version. Pass --no-sync to skip.
#
# The tunnel is OUTBOUND from this workstation, so a router, NAT or firewall on
# this end does not matter:
#
#   127.0.0.1:LOCAL_PORT  ->  hive login node  ->  compute node:REMOTE_PORT
#
# Nothing listens on a public address here, and the compute node never has to be
# reachable from outside the cluster.
set -euo pipefail

# NOTE for anyone editing: `set -e` and `set -o pipefail` are both on, so ANY
# command substitution containing a pipe must end in `|| true` unless a failure
# there really should abort. A remote helper that legitimately fails while
# polling -- awk exiting 2 because the endpoint file does not exist yet, ssh
# exiting 255 because the login node throttled us -- otherwise kills this script
# with NO message at all. That is what "waiting for the scheduler" followed by a
# bare `exit 2` was, twice.

HIVE_HOST="${OPENCODE_HIVE_HOST:-hive.hpc.ucdavis.edu}"
HIVE_USER="${OPENCODE_HIVE_USER:-gw}"
ROOT="${OPENCODE_HIVE_ROOT:-/quobyte/metabolomicsgrp/it/llm}"
# "auto" asks the scheduler which of these can start soonest. Type matters far
# more than it looks: measured within one minute, the earliest start ranged from
# 15 minutes (a6000) to over four hours (6000_blackwell) to the next day
# (nvidia_l40s). Pinning one type is how a session waits half a day for a GPU
# while five others sit idle.
#
# Every candidate has at least 48 GiB, which is what the Q8 preset needs: ~28
# GiB of weights, 8 GiB of f16 KV at the full 262,144 context, and compute. A
# 32 GiB card (nvidia_rtx_5000_ada_generation) is deliberately NOT here.
GPU="${OPENCODE_HIVE_GPU:-auto}"
GPU_CANDIDATES="${OPENCODE_HIVE_GPU_CANDIDATES:-6000_blackwell,nvidia_a100-sxm4-80gb,nvidia_a100_80gb_pcie,a100,a6000,nvidia_l40s}"
NGPU="${OPENCODE_HIVE_NGPU:-1}"
WALLTIME="${OPENCODE_HIVE_TIME:-12:00:00}"
ACCOUNT="${OPENCODE_HIVE_ACCOUNT:-publicgrp}"
PARTITION="${OPENCODE_HIVE_PARTITION:-low}"
REMOTE_PORT="${OPENCODE_HIVE_REMOTE_PORT:-8080}"
# NOT 8080: the local llama.cpp router already owns that port on this machine,
# and a tunnel onto it would either fail to bind or silently shadow the local
# node, so every "local" request would quietly go to the cluster.
LOCAL_PORT="${OPENCODE_HIVE_LOCAL_PORT:-11111}"
# The SSH forward does NOT land on LOCAL_PORT. hive-proxy.py owns that, so the
# port OpenCode talks to stays open through a reconnect, a node change, or a
# whole new allocation; the forward lands here and is free to come and go.
FORWARD_PORT="${OPENCODE_HIVE_FORWARD_PORT:-$((LOCAL_PORT + 1))}"
PROVIDER="${OPENCODE_HIVE_PROVIDER:-qwen-hive}"
LAUNCH=1
SYNC=1

STATE="${XDG_CACHE_HOME:-${HOME}/.cache}/opencode-hive"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "${STATE}"

# Multiplex every remote call over ONE connection. Without it each poll opens a
# fresh SSH session, and a login node shared by a whole campus throttles that
# long before it looks like throttling: connections start failing with
# "kex_exchange_identification: read: Connection timed out", the helpers return
# empty, and the driver concludes a job that is plainly RUNNING has not started.
# The symptom points at the scheduler; the cause is the connection rate.
SSH_MUX=(-o ControlMaster=auto
         -o "ControlPath=${STATE}/ssh-%r@%h:%p"
         -o ControlPersist=300
         -o BatchMode=yes -o ConnectTimeout=20
         -o ServerAliveInterval=30 -o ServerAliveCountMax=3)

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; }
say()   { printf '\033[1m==\033[0m %s\n' "$*"; }
warn()  { printf '\033[33m!!\033[0m %s\n' "$*" >&2; }
die()   { printf '\033[31m!!\033[0m %s\n' "$*" >&2; exit 1; }

# Slurm is not on PATH in a non-login shell on this cluster -- `ssh host sinfo`
# gives "command not found". Everything remote goes through a login shell.
hssh() { ssh "${SSH_MUX[@]}" "${HIVE_USER}@${HIVE_HOST}" "bash -lc 'bash -s'"; }

CMD="up"
case "${1:-}" in
  up|status|stop|logs) CMD="$1"; shift ;;
  -h|--help) usage; exit 0 ;;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    --gpu)        GPU="$2"; shift 2 ;;
    --gpus)       NGPU="$2"; shift 2 ;;
    --time)       WALLTIME="$2"; shift 2 ;;
    --local-port) LOCAL_PORT="$2"; shift 2 ;;
    --no-launch)  LAUNCH=0; shift ;;
    --no-sync)    SYNC=0; shift ;;
    -h|--help)    usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

# --- remote helpers ----------------------------------------------------------

job_id() { hssh <<< "squeue -u ${HIVE_USER} -n qwen-serve -h -o '%i %T' | awk '\$2==\"RUNNING\"{print \$1; exit}'"; }

# Only accept an endpoint published BY THE JOB BEING WAITED ON. A file left by
# a previous job names a node that is no longer serving, and the tunnel then
# connects confidently to nothing.
endpoint_node() {
  local want="$1"
  hssh <<REMOTE
awk -v want="${want}" '
  /^job/  { j = \$3 }
  /^node/ { n = \$3 }
  END     { if (j == want && n != "") print n }
' ${ROOT}/logs/endpoint.txt 2>/dev/null
REMOTE
}

api_key() { hssh <<< "cat ${ROOT}/logs/api-key.txt 2>/dev/null"; }

stack_ready() {
  hssh <<REMOTE
ls ${ROOT}/models/*.gguf >/dev/null 2>&1 \
  && [ -x ${ROOT}/opt/llama.cpp/bin/llama-server ] \
  && echo ready || echo missing
REMOTE
}

# Ask the scheduler, do not guess. Progress goes to STDERR: this function's
# stdout IS its return value, and a `say` inside it ends up concatenated into
# the chosen GPU name. `--test-only` allocates nothing and returns
# "Job N to start at <ISO timestamp>", so the choice is made on the cluster's
# own estimate rather than on which card is nominally fastest.
pick_gpu() {
  local best="" best_ts="" t out ts
  for t in ${GPU_CANDIDATES//,/ }; do
    out="$(hssh <<REMOTE 2>/dev/null || true
sbatch --test-only -p ${PARTITION} -A ${ACCOUNT} --gres=gpu:${t}:${NGPU} \
  -c 8 --mem=24G -t ${WALLTIME} --wrap=true 2>&1 | head -1
REMOTE
)"
    ts="$(printf '%s' "$out" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}' | head -1 || true)"
    [ -z "$ts" ] && continue
    printf '   %-26s could start %s\n' "$t" "$ts" >&2
    if [ -z "$best_ts" ] || [ "$ts" \< "$best_ts" ]; then
      best="$t"; best_ts="$ts"
    fi
  done
  if [ -z "$best" ]; then
    # Nothing answered with an estimate; fall back to the first candidate and
    # let the queue decide rather than refusing to run.
    best="${GPU_CANDIDATES%%,*}"
    printf '   no start estimates; falling back to %s\n' "$best" >&2
  fi
  printf '%s' "$best"
}

# --- commands ----------------------------------------------------------------

do_status() {
  local jid node
  jid="$(job_id || true)"
  printf '  stack   : %s\n' "$(stack_ready | tail -1 || true)"
  printf '  job     : %s\n' "${jid:-none running}"
  if [ -n "$jid" ]; then printf '  node    : %s\n' "$(endpoint_node "$jid" | tail -1 || true)"; fi
  if [ -s "${STATE}/tunnel.pid" ] && kill -0 "$(cat "${STATE}/tunnel.pid")" 2>/dev/null; then
    printf '  tunnel  : up (pid %s) 127.0.0.1:%s -> %s, %s reconnect(s)\n' \
      "$(cat "${STATE}/tunnel.pid")" "${LOCAL_PORT}" \
      "$(cat "${STATE}/tunnel.node" 2>/dev/null || echo '?')" \
      "$(cat "${STATE}/tunnel.reconnects" 2>/dev/null || echo 0)"
  else
    printf '  tunnel  : down\n'
  fi
  if [ -s "${STATE}/proxy.pid" ] && kill -0 "$(cat "${STATE}/proxy.pid")" 2>/dev/null; then
    printf '  proxy   : holding 127.0.0.1:%s (state: %s)\n' "${LOCAL_PORT}" \
      "$(cat "${STATE}/tunnel.state" 2>/dev/null || echo unknown)"
  else
    printf '  proxy   : down\n'
  fi
  if curl -fsS -m 5 "http://127.0.0.1:${LOCAL_PORT}/health" >/dev/null 2>&1; then
    printf '  endpoint: responding\n'
  else
    printf '  endpoint: not responding\n'
  fi
}

do_stop() {
  stop_proxy
  if [ -s "${STATE}/tunnel.pid" ]; then
    stop_tunnel
    say "tunnel and proxy closed"
  fi
  local jid; jid="$(job_id || true)"
  if [ -n "$jid" ]; then
    hssh <<< "scancel ${jid}" && say "cancelled job ${jid}"
  fi
}

do_logs() { ssh -o BatchMode=yes "${HIVE_USER}@${HIVE_HOST}" "tail -f ${ROOT}/logs/serve-*.out"; }

# The tunnel is supervised rather than started once. `low` is preemptible with a
# 130s grace period, so the job can be requeued onto a DIFFERENT node mid-session;
# when that happens the old forward is dead and the new node is only discoverable
# by re-reading endpoint.txt.
# True if a supervisor from a previous run is alive and healthy.
tunnel_alive() {
  [ -s "${STATE}/tunnel.pid" ] || return 1
  kill -0 "$(cat "${STATE}/tunnel.pid")" 2>/dev/null
}

stop_tunnel() {
  if [ -s "${STATE}/tunnel.pid" ]; then
    kill "$(cat "${STATE}/tunnel.pid")" 2>/dev/null || true
    sleep 1
    kill -9 "$(cat "${STATE}/tunnel.pid")" 2>/dev/null || true
    rm -f "${STATE}/tunnel.pid"
  fi
  # The supervisor's ssh child does not die with it, and an orphaned forward
  # still holds the local port -- which is what a fresh supervisor then fails
  # to bind, backing off instead of connecting.
  pkill -f "ssh -N .*-L ${FORWARD_PORT}:" 2>/dev/null || true
}

# The always-open near side. Started before the tunnel and left running, so a
# client that connects during an outage is held rather than refused.
start_proxy() {
  if [ -s "${STATE}/proxy.pid" ] && kill -0 "$(cat "${STATE}/proxy.pid")" 2>/dev/null; then
    return 0
  fi
  setsid nohup python3 "${HERE}/hive-proxy.py" \
      --listen "${LOCAL_PORT}" --upstream "${FORWARD_PORT}" \
      >> "${STATE}/proxy.log" 2>&1 &
  echo $! > "${STATE}/proxy.pid"
  sleep 1
  say "proxy holding 127.0.0.1:${LOCAL_PORT} (upstream ${FORWARD_PORT})"
}

stop_proxy() {
  if [ -s "${STATE}/proxy.pid" ]; then
    kill "$(cat "${STATE}/proxy.pid")" 2>/dev/null || true
    rm -f "${STATE}/proxy.pid"
  fi
}

start_tunnel() {
  local node="$1"
  # One supervisor, always. Each `up` used to start another, and they then
  # competed for the local port: the loser logged "Address already in use",
  # backed off, and turned a two-second reconnect into half a minute. A stale
  # supervisor is also pointed at whatever node was serving LAST time.
  if tunnel_alive; then
    say "replacing the existing tunnel supervisor"
  fi
  stop_tunnel
  # setsid, not just nohup: the supervisor has to outlive the shell that
  # started it, including when that shell is part of a process group the
  # terminal or a job runner tears down. Without it the tunnel died silently
  # alongside its parent and the endpoint simply stopped answering.
  HIVE_USER="${HIVE_USER}" HIVE_HOST="${HIVE_HOST}" ROOT="${ROOT}" \
  STATE="${STATE}" FORWARD_PORT="${FORWARD_PORT}" REMOTE_PORT="${REMOTE_PORT}" \
  NODE="${node}" GPU="${GPU}" NGPU="${NGPU}" WALLTIME="${WALLTIME}" \
    setsid nohup "${HERE}/tunnel-supervisor.sh" >> "${STATE}/tunnel.log" 2>&1 &
  echo $! > "${STATE}/tunnel.pid"
  sleep 2
}

# Push the repo's copies over the cluster's on every run. The alternative is
# scp-by-hand, which means the version running on hive drifts from the version
# under review here, and the difference is invisible until something behaves
# differently there for no apparent reason. The repo is the source of truth.
sync_artifacts() {
  say "syncing job scripts to ${ROOT}"
  hssh <<< "mkdir -p ${ROOT}/logs"
  scp -q -o ControlMaster=auto -o "ControlPath=${STATE}/ssh-%r@%h:%p" \
         "${HERE}/setup-hive.sh" "${HERE}/serve-qwen.sbatch" \
         "${HERE}/gen-preset.py" "${HERE}/tunnel-supervisor.sh" \
         "${HERE}/README.md" \
         "${HIVE_USER}@${HIVE_HOST}:${ROOT}/" \
    || die "could not copy job scripts to ${ROOT}"
  hssh <<< "chmod +x ${ROOT}/setup-hive.sh ${ROOT}/serve-qwen.sbatch"
}

do_up() {
  say "checking hive"
  hssh <<< "true" >/dev/null || die "cannot reach ${HIVE_USER}@${HIVE_HOST}"
  if [ "$SYNC" = 1 ]; then sync_artifacts; fi

  if [ "$(stack_ready | tail -1 || true)" != "ready" ]; then
    say "llama.cpp or weights missing — running setup (this takes a while)"
    hssh <<REMOTE
cd ${ROOT} && sbatch --time=01:00:00 --cpus-per-task=16 --mem=48G \
  -o ${ROOT}/logs/setup-%j.out setup-hive.sh
REMOTE
    say "setup submitted; re-run 'opencode_hive' once it finishes"
    say "watch it with: ssh ${HIVE_USER}@${HIVE_HOST} 'tail -f ${ROOT}/logs/setup-*.out'"
    exit 0
  fi

  local jid; jid="$(job_id || true)"
  if [ -n "$jid" ]; then
    say "reusing running job ${jid}"
  else
    if [ "$GPU" = auto ]; then
      say "asking the scheduler which GPU can start soonest"
      GPU="$(pick_gpu)"
      say "choosing ${GPU}"
    fi
    say "requesting ${NGPU}x ${GPU} for ${WALLTIME}"
    hssh <<REMOTE
cd ${ROOT} && sbatch --gres=gpu:${GPU}:${NGPU} --time=${WALLTIME} \
  -p ${PARTITION} -A ${ACCOUNT} -o ${ROOT}/logs/serve-%j.out serve-qwen.sbatch
REMOTE
    say "waiting for the scheduler"
    for _ in $(seq 1 80); do
      jid="$(job_id || true)"
      if [ -n "$jid" ]; then break; fi
      sleep 30
    done
    [ -n "$jid" ] || die "job did not start; check: opencode_hive status"
  fi

  local node
  for _ in $(seq 1 60); do
    node="$(endpoint_node "$jid" | tail -1 || true)"
    if [ -n "$node" ]; then break; fi
    sleep 5
  done
  [ -n "$node" ] || die "job ${jid} is running but published no endpoint"
  say "node ${node}"

  start_proxy
  start_tunnel "$node"
  local key; key="$(api_key | tail -1 || true)"
  [ -n "$key" ] || die "no API key at ${ROOT}/logs/api-key.txt"

  say "waiting for the model to load (weights stage to local NVMe first)"
  local ok=0
  for _ in $(seq 1 180); do
    if curl -fsS -m 5 -H "Authorization: Bearer ${key}" \
         "http://127.0.0.1:${LOCAL_PORT}/v1/models" >/dev/null 2>&1; then ok=1; break; fi
    sleep 10
  done
  [ "$ok" = 1 ] || die "endpoint never answered; see ${STATE}/tunnel.log and 'opencode_hive logs'"

  say "configuring OpenCode provider '${PROVIDER}'"
  local presets; presets="$(mktemp)"
  # From the ACTIVE preset the running job published, never the template. The
  # template describes a 96 GiB card; this job may be on 46 GiB, in which case
  # the template names models that do not exist and contexts the pool cannot
  # fund.
  scp -q "${HIVE_USER}@${HIVE_HOST}:${ROOT}/logs/router-presets.active.ini" \
      "$presets" \
    || die "job ${jid} published no active preset; is it still starting?"
  # --set-default is deliberately NOT passed: the local 4090 provider stays the
  # default and hive is opt-in per session, so losing the cluster job does not
  # leave the client pointed at a dead endpoint.
  python3 "${HERE}/../scripts/configure-opencode.py" \
      --presets "$presets" --provider "${PROVIDER}" \
      --provider-name "Qwen on hive (${GPU}, job ${jid})" \
      --host 127.0.0.1 --port "${LOCAL_PORT}" --api-key "${key}"
  rm -f "$presets"

  say "ready — pick a '${PROVIDER}/...' model inside OpenCode"
  if [ "$LAUNCH" = 1 ]; then exec opencode; fi
}

case "$CMD" in
  up)     do_up ;;
  status) do_status ;;
  stop)   do_stop ;;
  logs)   do_logs ;;
esac
