[Unit]
# Instance name is the profile: autospec-qwen38@interactive.service etc.
# This template replaces the separately-named per-profile units the spec
# sketched; see ../README.md ("Simplifications") for why.
Description=Qwen3.8-27B vLLM inference node (profile %i)
Documentation=file:///opt/qwen-vllm/etc/common.conf
Wants=network-online.target
After=network-online.target
# The llama.cpp node holds ~23 GiB of the 24 GiB card. The two runtimes cannot
# co-reside, and Conflicts= is bidirectional, so whichever is started last wins
# instead of the newcomer OOMing several minutes into its profiling pass.
Conflicts=qwen-local.service

[Service]
Type=exec
User=qwen-vllm
Group=qwen-vllm
WorkingDirectory=/var/lib/qwen-vllm
Environment=QWEN38_CONF_DIR=/opt/qwen-vllm/etc
ExecStart=/opt/qwen-vllm/bin/serve-profile.sh %i

Restart=on-failure
RestartSec=10
# A cold start downloads nothing but does load ~20 GiB of weights and may run
# torch.compile; systemd must not shoot it partway through.
TimeoutStartSec=1200
TimeoutStopSec=120
KillSignal=SIGINT

UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/qwen-vllm

# NOTE — deliberately NOT set, and why:
#   PrivateDevices=true      hides /dev/nvidia*, so CUDA cannot initialise.
#   DevicePolicy=closed      same.
#   MemoryDenyWriteExecute=  breaks the CUDA JIT and torch.compile.
#   ProtectSystem=strict     blocks the NVIDIA driver's /proc and /sys access.
# ProtectSystem=full is the strongest setting that leaves the CUDA stack working
# on this host; it still makes /usr and /boot read-only.

[Install]
WantedBy=multi-user.target
