# Dual-Turing node: this site's own coordinates.
#
# Copy to ${XDG_CONFIG_HOME:-~/.config}/qwen-turing/site.conf and fill in, then
#     chmod 600 ~/.config/qwen-turing/site.conf
#
# These are properties of a site, not of this tooling, and this repository is
# public. Nothing here is a secret -- the API key lives elsewhere, in a
# root-only file -- but an address and an interface name are your network's
# details to publish, not ours.
#
# The `: "${VAR:=value}"` form means an environment variable already set wins
# over this file.

# The address the inference endpoint binds. Nothing else may bind it, and it
# should be the narrowest interface that your clients can still reach.
: "${QT_NODE_ADDR:=<node-addr>}"

# The interface that address lives on. Recorded so the firewall and any NIC
# tuning act on the same device the service is actually using.
: "${QT_UPLINK_IF:=<uplink-if>}"

# Where GGUF weights live. Must be fast and roomy, and must NOT be the root
# filesystem -- two models are ~22 GB together and a root filesystem is usually
# the smallest thing on the box.
: "${QT_MODELS_DIR:=<nvme-array>/qwen-gguf}"

# The inference port.
: "${QT_PORT:=8080}"

# The dashboard binds its OWN address and port. Kept separate from
# QT_NODE_ADDR because the two are exposed to different audiences: the
# inference endpoint may need to be reachable more widely than a page that
# shows what the node is doing.
: "${QT_DASH_ADDR:=<dash-addr>}"
: "${QT_DASH_PORT:=8081}"

# ---------------------------------------------------------------------------
# Everything below is read ONLY by the gateway (per-user keys, usage
# accounting, federation). A node that serves inference without them starts
# and runs normally -- see QT_GATEWAY_REQUIRED_VARS in scripts/site.sh.
# ---------------------------------------------------------------------------

# The name clients and the identity provider use to reach this node. It must
# match the app client's registered callback host exactly, or the login
# redirect is refused with `redirect_mismatch`.
: "${QT_PUBLIC_FQDN:=<node-fqdn>}"

# Identity provider coordinates. The pool is shared with other applications,
# so this node gets its OWN app client -- a public client with no secret, which
# is why none is configured here.
: "${QT_COGNITO_REGION:=<aws-region>}"
: "${QT_COGNITO_POOL_ID:=<user-pool-id>}"
: "${QT_COGNITO_CLIENT_ID:=<app-client-id>}"

# Hosted login domain, host part only, no scheme. Either the pool's prefix
# domain (<prefix>.auth.<region>.amazoncognito.com) or a custom domain.
: "${QT_COGNITO_DOMAIN:=<hosted-login-domain>}"

# Group names that authorise minting, read from the VERIFIED token only --
# never from a request header. A user in neither group authenticates and is
# authorised for nothing.
: "${QT_COGNITO_USER_GROUP:=<user-group-name>}"
: "${QT_COGNITO_ADMIN_GROUP:=<admin-group-name>}"

# Key registry. The application role holds no DDL privilege, so a compromised
# node cannot alter the schema it reads.
: "${QT_DB_HOST:=<db-host>}"
: "${QT_DB_PORT:=6432}"
: "${QT_DB_NAME:=<db-name>}"
: "${QT_DB_USER:=<db-app-role>}"

# Path to the file holding the application role's password -- a PATH, never the
# password itself. Mode 600, root-owned, delivered to the unit through systemd
# LoadCredential and never through Environment=, which any local user can read
# with `systemctl show`.
: "${QT_DB_PASSWORD_FILE:=/etc/qwen-turing/llmgw_app.pw}"
