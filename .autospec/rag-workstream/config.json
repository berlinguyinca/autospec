{
  "schema_version": 1,
  "corpus": {
    "include": ["llms.txt", "llms-full.txt", "docs/**/*.md", "README.md", "SKILLS.md"],
    "exclude": ["docs/memory/diary/**"]
  },
  "chunking": {
    "strategy": "structure_aware",
    "late_chunking": true,
    "contextual_prefix": true,
    "chunk_size": 900,
    "overlap": 120,
    "preserve_code_fences": true,
    "preserve_heading_body": true
  },
  "embedding": {
    "model_id": "jina-embeddings-v2-base-en",
    "index_version_prefix": "rag-index-v1"
  },
  "retrieval": {
    "mode": "hybrid_dense_bm25_rrf",
    "dense_top_k": 50,
    "bm25_top_k": 50,
    "rrf_k": 60,
    "rerank_top_n": 50,
    "final_n": 8,
    "metadata_filters": ["index_version", "doc_version", "section", "product_area"]
  },
  "query_transform": {
    "rewrite": true,
    "hyde": "routed",
    "multi_query": "routed",
    "decomposition": "routed"
  },
  "freshness": {
    "serve_latest": true,
    "invalidate_by": ["doc_id", "content_hash"],
    "keep_prior_versions_filterable": true
  },
  "eval": {
    "target_metric": "ndcg",
    "retrieval_metrics": ["precision_at_k", "recall_at_k", "mrr", "ndcg"],
    "ragas_metrics": ["faithfulness", "answer_relevancy", "context_precision", "context_recall"],
    "ragas_faithfulness_floor": 0.90,
    "promote_only_score_positive": true
  },
  "handoffs": {
    "1548": "ingestion, structure-aware chunking, late/contextual chunking, and config-versioned index materialization",
    "1549": "hybrid dense+BM25 RRF retrieval, reranking, and metadata filtering",
    "1550": "query-transform router for rewrite, HyDE, multi-query, and decomposition",
    "1551": "golden-set eval harness, RAGAS nightly scoring, and autonomous tuning loop",
    "1552": "incremental freshness, content-hash invalidation, version serving, and citation verification"
  }
}
