{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berlinguyinca/autospec/schemas/autospec-proof-matrix.schema.json",
  "title": "autospec QA proof matrix",
  "description": "Machine-readable traceability proof from spec requirement to implementation, automated tests, live evidence, blockers, and follow-ups.",
  "type": "object",
  "required": ["schema_version", "freshness", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "freshness": { "$ref": "#/$defs/freshness" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "spec_reference",
          "expected_behavior",
          "implementation_files",
          "automated_tests",
          "live_evidence",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "spec_reference": { "type": "string", "minLength": 1 },
          "expected_behavior": { "type": "string", "minLength": 1 },
          "implementation_files": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "automated_tests": {
            "type": "array",
            "items": { "$ref": "#/$defs/test_evidence" }
          },
          "live_evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "PARTIAL", "NOT_TESTED", "AMBIGUOUS"]
          },
          "blocker": { "type": "string" },
          "follow_up": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "PASS" } } },
            "then": {
              "properties": {
                "automated_tests": { "minItems": 1 },
                "live_evidence": { "minItems": 1 }
              }
            }
          },
          {
            "if": { "properties": { "status": { "enum": ["FAIL", "PARTIAL", "NOT_TESTED", "AMBIGUOUS"] } } },
            "then": { "anyOf": [{ "required": ["blocker"] }, { "required": ["follow_up"] }] }
          }
        ]
      }
    }
  },
  "$defs": {
    "freshness": {
      "type": "object",
      "required": ["repo_commit_sha", "spec_file", "spec_hash", "environment", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "repo_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "spec_file": { "type": "string", "minLength": 1 },
        "spec_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "app_url": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "test_command_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "generated_at": { "type": "string", "minLength": 1 }
      }
    },
    "test_evidence": {
      "type": "object",
      "required": ["path", "name"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "result": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "summary"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["command", "screenshot", "video", "network", "api", "backend_probe", "log", "trace", "manual"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "status_code": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    }
  }
}
