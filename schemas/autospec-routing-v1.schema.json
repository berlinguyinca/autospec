{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospec.dev/schemas/autospec-routing-v1.schema.json",
  "title": "AutoSpec routing configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "harnesses", "routes", "inference_classes", "inferweave", "fallback"],
  "properties": {
    "version": {"const": 1},
    "harnesses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/harness"}
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/route"}
    },
    "inference_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/inferenceClass"}
    },
    "inferweave": {"$ref": "#/$defs/inferweave"},
    "fallback": {"$ref": "#/$defs/fallback"}
  },
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "transport", "provider_protocols"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "transport": {"enum": ["json", "rpc", "cli"]},
        "provider_protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["openai-compatible", "native"]}
        },
        "endpoint_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "api_key_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harnesses", "inference_class"],
      "properties": {
        "harnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "inference_class": {"type": "string", "minLength": 1},
        "independent_from": {"type": "string", "minLength": 1},
        "minimum_strength": {"type": "string", "minLength": 1},
        "allow_opportunistic": {"type": "boolean"}
      }
    },
    "inferenceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modalities", "max_input_tokens", "reserve_output_tokens", "max_queue_seconds"],
      "properties": {
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["text", "image"]}
        },
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "reserve_output_tokens": {"type": "integer", "minimum": 1},
        "max_queue_seconds": {"type": "integer", "minimum": 1},
        "eligible_node_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["mac", "rtx6000"]}
        }
      }
    },
    "inferweave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_url", "timeout_seconds", "maximum_age_seconds", "local_only"],
      "properties": {
        "discovery_url": {"type": "string", "format": "uri", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "maximum_age_seconds": {"type": "integer", "minimum": 1},
        "local_only": {"type": "boolean"},
        "allow_loopback_http": {"type": "boolean"}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "existing-routing"}}
    }
  }
}
