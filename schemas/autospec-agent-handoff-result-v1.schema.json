{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospec.dev/schemas/autospec-agent-handoff-result-v1.schema.json",
  "title": "AutoSpec agent handoff result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact_id", "created_at", "repository", "role", "status", "findings", "proposed_artifact", "producer", "inputs", "commands", "tools", "usage", "unresolved_questions", "error_category"],
  "properties": {
    "version": {"const": 1},
    "artifact_id": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "repository": {"type": "string", "minLength": 3},
    "role": {"enum": ["intent_planner", "repository_critic", "implementation_advisor", "reviewer"]},
    "status": {"enum": ["pass", "needs_revision", "blocked", "error"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "proposed_artifact": {"type": ["object", "null"]},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "cached_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "cached_tokens": {"type": "integer", "minimum": 0}}},
    "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "error_category": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "error"}}, "required": ["status"]},
      "then": {"properties": {"error_category": {"type": "string", "minLength": 1}}},
      "else": {"properties": {"error_category": {"type": "null"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "digest"], "properties": {"artifact_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["agent_id", "harness", "bridge", "provider_family", "model", "session_isolation", "access_mode"], "properties": {"agent_id": {"type": "string", "minLength": 1}, "harness": {"enum": ["pi", "claude", "codex", "opencode"]}, "bridge": {"type": "string", "minLength": 1}, "provider_family": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "session_isolation": {"enum": ["isolated", "continued"]}, "access_mode": {"enum": ["none", "read", "workspace-write"]}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["severity", "claim", "evidence", "confidence"], "properties": {"severity": {"enum": ["info", "warning", "blocking"]}, "claim": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/repoPath"}}, "confidence": {"enum": ["low", "medium", "high"]}}}
  }
}
