{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autospec Feature Slice",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "summary",
    "source_rules",
    "source_baselines",
    "requires_adapter",
    "supported_adapters",
    "implementation_kind",
    "runtime_claim_level",
    "risk_level",
    "allowed_paths",
    "forbidden_paths",
    "generated_artifacts",
    "metadata_updates",
    "validation_expectations",
    "acceptance_criteria",
    "not_in_scope",
    "stuck_if"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "category": { "type": "string" },
    "summary": { "type": "string" },
    "source_rules": { "type": "array", "items": { "type": "string" } },
    "source_baselines": { "type": "array", "items": { "type": "string" } },
    "requires_adapter": { "type": "boolean" },
    "supported_adapters": { "type": "array", "items": { "type": "string" } },
    "implementation_kind": { "enum": ["route", "component", "config", "test", "docs", "metadata", "mixed"] },
    "runtime_claim_level": { "enum": ["shell", "partial", "complete"] },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "required_inputs": { "type": "array", "items": { "type": "string" } },
    "generated_artifacts": { "type": "array", "items": { "type": "string" } },
    "metadata_updates": { "type": "array", "items": { "type": "string" } },
    "tests_generated": { "type": "array", "items": { "type": "string" } },
    "validation_expectations": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "not_in_scope": { "type": "array", "items": { "type": "string" } },
    "stuck_if": { "type": "array", "items": { "type": "string" } }
  }
}
