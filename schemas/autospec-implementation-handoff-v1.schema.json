{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospec.dev/schemas/autospec-implementation-handoff-v1.schema.json",
  "title": "AutoSpec implementation handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact_id", "created_at", "repository", "source_spec", "producer", "issue", "allowed_read_paths", "allowed_write_paths", "goal", "acceptance_criteria", "constraints", "invariants", "interfaces", "tests_required", "primary_smoke_test", "limits", "retry_findings", "closeout", "route"],
  "properties": {
    "version": {"const": 1},
    "artifact_id": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "repository": {"type": "string", "minLength": 3},
    "source_spec": {"$ref": "#/$defs/source"},
    "producer": {"$ref": "#/$defs/producer"},
    "issue": {"type": "object", "additionalProperties": false, "required": ["number", "title", "branch", "worktree", "claim_generation"], "properties": {"number": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "worktree": {"$ref": "#/$defs/repoPath"}, "claim_generation": {"type": "integer", "minimum": 1}}},
    "allowed_read_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
    "allowed_write_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
    "goal": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "interfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tests_required": {"type": "array", "minItems": 1, "items": {"enum": ["unit", "integration", "smoke", "e2e"]}},
    "primary_smoke_test": {"type": "string", "minLength": 1},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_tool_calls", "max_self_review_iterations"], "properties": {"max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 40}, "max_self_review_iterations": {"type": "integer", "minimum": 1, "maximum": 3}}},
    "retry_findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "closeout": {"type": "object", "additionalProperties": false, "required": ["path", "schema"], "properties": {"path": {"$ref": "#/$defs/repoPath"}, "schema": {"const": "autospec-implementation-closeout-v1.schema.json"}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["harness", "model", "reasoning_effort"], "properties": {"harness": {"enum": ["pi", "claude", "codex", "opencode"]}, "model": {"type": "string", "minLength": 1}, "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "digest"], "properties": {"artifact_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["agent_id", "harness", "bridge", "provider_family", "model", "session_isolation", "access_mode"], "properties": {"agent_id": {"type": "string", "minLength": 1}, "harness": {"enum": ["pi", "claude", "codex", "opencode"]}, "bridge": {"type": "string", "minLength": 1}, "provider_family": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "session_isolation": {"enum": ["isolated", "continued"]}, "access_mode": {"enum": ["none", "read", "workspace-write"]}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["id", "text", "verification"], "properties": {"id": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"}, "text": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}}}
  }
}
