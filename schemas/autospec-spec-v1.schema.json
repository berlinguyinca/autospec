{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospec.dev/schemas/autospec-spec-v1.schema.json",
  "title": "AutoSpec approved specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact_id", "created_at", "repository", "sources", "producer", "status", "goal", "non_goals", "constraints", "invariants", "affected_surfaces", "decisions", "acceptance_criteria", "tests_required", "primary_smoke_test", "risks", "planning_evidence", "material_questions"],
  "properties": {
    "version": {"const": 1},
    "artifact_id": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "producer": {"$ref": "#/$defs/producer"},
    "status": {"enum": ["proposal", "needs_revision", "approved"]},
    "goal": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "affected_surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "tests_required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["unit", "integration", "smoke", "e2e"]}},
    "primary_smoke_test": {"type": "string", "minLength": 1},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "planning_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "material_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "properties": {
          "sources": {"type": "array", "minItems": 2},
          "planning_evidence": {"type": "array", "minItems": 2},
          "material_questions": {"type": "array", "maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "digest"], "properties": {"artifact_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["agent_id", "harness", "bridge", "provider_family", "model", "session_isolation", "access_mode"], "properties": {"agent_id": {"type": "string", "minLength": 1}, "harness": {"enum": ["pi", "claude", "codex", "opencode"]}, "bridge": {"type": "string", "minLength": 1}, "provider_family": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "session_isolation": {"enum": ["isolated", "continued"]}, "access_mode": {"enum": ["none", "read", "workspace-write"]}}},
    "surface": {"type": "object", "additionalProperties": false, "required": ["path", "state", "symbols"], "properties": {"path": {"$ref": "#/$defs/repoPath"}, "state": {"enum": ["existing", "proposed"]}, "symbols": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision", "rationale", "rejected_alternatives"], "properties": {"decision": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "rejected_alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["id", "text", "verification"], "properties": {"id": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"}, "text": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["risk", "mitigation"], "properties": {"risk": {"type": "string", "minLength": 1}, "mitigation": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["role", "result_artifact_id", "digest"], "properties": {"role": {"enum": ["intent_planner", "repository_critic"]}, "result_artifact_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
