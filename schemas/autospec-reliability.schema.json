{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berlinguyinca/autospec/schemas/autospec-reliability.schema.json",
  "title": "autospec generated app reliability contract",
  "description": "Contract for required live smoke workflows, representative data, allowed mocks, health probes, fallback behavior, and false-green bans.",
  "type": "object",
  "required": ["schema_version", "freshness", "workflows", "forbidden_false_green"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "freshness": { "$ref": "#/$defs/freshness" },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "representative_inputs", "mock_policy", "no_mock_required", "expected_result"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "route_or_screen": { "type": "string" },
          "representative_inputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "seed_or_live_data": { "type": "string" },
          "mock_policy": { "type": "string", "enum": ["mock_allowed", "mock_plus_no_mock", "no_mock_only"] },
          "no_mock_required": { "type": "boolean" },
          "health_probes": {
            "type": "array",
            "items": { "$ref": "#/$defs/probe" }
          },
          "fallback_behavior": { "type": "string" },
          "expected_result": { "type": "string", "minLength": 1 },
          "blocker": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "no_mock_required": { "const": true } } },
            "then": { "properties": { "health_probes": { "minItems": 1 } } }
          }
        ]
      }
    },
    "forbidden_urls": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_false_green": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["dom_only_pass", "request_only_pass", "mocked_only_pass", "screenshot_only_pass", "generic_panel_changed"]
      }
    },
    "deprecated_surfaces": {
      "type": "array",
      "description": "Legacy routes, caches, buckets, stores, workers, flags, config keys, UI paths, or data sources that must not be revived to make QA pass.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "replacement", "forbidden_action", "cleanup_status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["route", "cache", "bucket", "storage_backend", "worker", "feature_flag", "config_key", "ui_path", "data_source", "fallback", "other"]
          },
          "replacement": { "type": "string", "minLength": 1 },
          "forbidden_action": { "type": "string", "minLength": 1 },
          "cleanup_status": { "type": "string", "enum": ["removed", "pending", "temporary_compatibility"] },
          "spec_cleanup": { "type": "string" },
          "code_cleanup": { "type": "string" },
          "data_cleanup": { "type": "string" },
          "sunset_issue": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "cleanup_status": { "enum": ["pending", "temporary_compatibility"] } } },
            "then": { "required": ["sunset_issue"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "freshness": {
      "type": "object",
      "required": ["repo_commit_sha", "spec_file", "spec_hash", "environment", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "repo_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "spec_file": { "type": "string", "minLength": 1 },
        "spec_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "app_url": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "test_command_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "generated_at": { "type": "string", "minLength": 1 }
      }
    },
    "probe": {
      "type": "object",
      "required": ["name", "kind", "target", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["http", "api", "queue", "worker", "database", "cache", "external"] },
        "target": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 }
      }
    }
  }
}
