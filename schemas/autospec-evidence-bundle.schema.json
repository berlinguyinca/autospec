{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospec.local/schemas/autospec-evidence-bundle.schema.json",
  "title": "AutoSpec Evidence Bundle",
  "type": "object",
  "required": ["run_id", "commands", "artifacts"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "stdout_path", "stderr_path"],
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "stdout_path": { "type": "string" },
          "stderr_path": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
