{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berlinguyinca/autospec/schemas/autospec-mutation-proof.schema.json",
  "title": "autospec mutation and breakage proof",
  "description": "Proof that critical workflow tests fail when request propagation, rendering, fallback, persistence, or backend responses regress.",
  "type": "object",
  "required": ["schema_version", "freshness", "mutations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "freshness": { "$ref": "#/$defs/freshness" },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["workflow_id", "mutation_type", "test", "expected_failure", "observed_result"],
        "additionalProperties": false,
        "properties": {
          "workflow_id": { "type": "string", "minLength": 1 },
          "mutation_type": {
            "type": "string",
            "enum": ["request_payload", "result_rendering", "backend_failure", "fallback_disabled", "persistence_removed", "validation_bypass"]
          },
          "test": { "$ref": "#/$defs/test_evidence" },
          "expected_failure": { "type": "string", "minLength": 1 },
          "observed_result": { "type": "string", "enum": ["failed_as_expected", "stayed_green", "not_run"] },
          "strengthening_performed": { "type": "string" },
          "blocker": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "observed_result": { "enum": ["stayed_green", "not_run"] } } },
            "then": { "anyOf": [{ "required": ["strengthening_performed"] }, { "required": ["blocker"] }] }
          }
        ]
      }
    }
  },
  "$defs": {
    "freshness": {
      "type": "object",
      "required": ["repo_commit_sha", "spec_file", "spec_hash", "environment", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "repo_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "spec_file": { "type": "string", "minLength": 1 },
        "spec_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "app_url": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "test_command_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "generated_at": { "type": "string", "minLength": 1 }
      }
    },
    "test_evidence": {
      "type": "object",
      "required": ["path", "name"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "result": { "type": "string" }
      }
    }
  }
}
