{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospec.dev/schemas/autospec-review-handoff-v1.schema.json",
  "title": "AutoSpec review handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact_id", "created_at", "repository", "source_implementation", "producer", "base_commit", "head_commit", "changed_paths", "closeout", "acceptance_criteria", "rerun_commands", "required_independence", "checks", "verdict"],
  "properties": {
    "version": {"const": 1},
    "artifact_id": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "repository": {"type": "string", "minLength": 3},
    "source_implementation": {"$ref": "#/$defs/source"},
    "producer": {"$ref": "#/$defs/producer"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
    "closeout": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "claims"], "properties": {"path": {"$ref": "#/$defs/repoPath"}, "digest": {"$ref": "#/$defs/digest"}, "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "rerun_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_independence": {"type": "object", "additionalProperties": false, "required": ["provider_family", "session"], "properties": {"provider_family": {"type": "string", "minLength": 1}, "session": {"const": "isolated"}}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "verdict": {"type": "object", "additionalProperties": false, "required": ["path", "schema"], "properties": {"path": {"$ref": "#/$defs/repoPath"}, "schema": {"const": "autospec-agent-handoff-result-v1.schema.json"}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "digest"], "properties": {"artifact_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["agent_id", "harness", "bridge", "provider_family", "model", "session_isolation", "access_mode"], "properties": {"agent_id": {"type": "string", "minLength": 1}, "harness": {"enum": ["pi", "claude", "codex", "opencode"]}, "bridge": {"type": "string", "minLength": 1}, "provider_family": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "session_isolation": {"enum": ["isolated", "continued"]}, "access_mode": {"enum": ["none", "read", "workspace-write"]}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["id", "text", "verification"], "properties": {"id": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"}, "text": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim", "label", "proof_type", "evidence"], "properties": {"claim": {"type": "string", "minLength": 1}, "label": {"enum": ["verified", "assumed", "couldnt-verify", "likely-wrong"]}, "proof_type": {"enum": ["runtime", "static"]}, "evidence": {"type": "string", "minLength": 1}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["name", "status", "evidence"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "not_run"]}, "evidence": {"type": "string", "minLength": 1}}}
  }
}
